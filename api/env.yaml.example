# =============================================================================
# Databook API env.yaml — Copy this file to env.yaml and fill in the values.
# =============================================================================
# ⚠️ This file MUST exist before starting the API container.
#    If missing, Docker will mount it as a directory and cause an IsADirectoryError.
#
# ⚠⚠ THESE ARE PLACEHOLDERS, NOT DEFAULTS. Copying them verbatim is how prod ended
#    up signing every JWT with the published value `supersecretkey`, which anyone
#    could forge. Generate real secrets (the api logs a SECURITY warning + a
#    Sentry error on boot if it sees a known weak signing key).

db:
  # Only user / dbname / host live here. The Postgres PASSWORD is a Docker secret
  # (secrets/postgres_api_password, read via POSTGRES_PASSWORD_FILE) — do NOT add
  # a `pwd:` or `addr:` line, those were removed in #170 and reading them back in
  # reintroduces the KeyError class fixed in #190.
  user: databook_api
  dbname: databook
  host: postgres              # Docker service name
fastapi:
  # ⚠⚠ SIGNS every JWT and is the machine-to-machine api_key. Generate a strong
  # random value — `openssl rand -hex 32` — NEVER `supersecretkey`. Rotate with
  # scripts/rotate-fastapi-key.sh (moves it across api + app FAPI_KEY + normalizer
  # together and re-mints the app token).
  key: REPLACE_WITH_openssl_rand_hex_32
masterpass: CHANGE_ME_sha256_hash_of_your_master_password

# The shared machine key (== fastapi.key) is sent to /import-csv and /upload in
# the `X-API-Key` HEADER. The `?api_key=` query form is deprecated — it wrote the
# key into the api access log in plaintext (fixed #192) — and logs a WARNING when
# used. Resolver: api/modules/apikey.py.
