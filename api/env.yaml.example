# =============================================================================
# Databook API env.yaml — Copy this file to env.yaml and fill in the values.
# =============================================================================
# ⚠️ This file MUST exist before starting the API container.
#    If missing, Docker will mount it as a directory and cause an IsADirectoryError.

db:
  user: postgres
  pwd: "secret"
  dbname: databook
  host: postgres              # Docker service name
  addr: pq://postgres:secret@postgres:5432/databook
fastapi:
  key: supersecretkey         # JWT signing key (used to sign/verify tokens)
masterpass: CHANGE_ME_sha256_hash_of_your_master_password
