# =============================================================================
# Databook Docker Compose .env — Copy this file to .env and fill in the values.
# =============================================================================

# --- PostgreSQL (main data store) --------------------------------------------
# Passwords are NOT set here on a deployed box — they live in ./secrets/* as
# Docker secrets so the value stays out of `docker inspect` and /proc/*/environ.
# See scripts/rotate-postgres-password.sh and scripts/split-postgres-roles*.sh,
# which create those files. POSTGRES_PASSWORD below is only a local-dev
# convenience and is ignored whenever a secret file is present.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=databook

# Per-service Postgres roles. Production runs least-privilege roles —
# databook_api owns the tables, databook_mcp is read-only — so the compose file
# demands these explicitly rather than defaulting to the superuser. For local
# development the single `postgres` role is fine.
API_POSTGRES_USER=postgres
MCP_POSTGRES_USER=postgres

# --- MySQL (Laravel metadata) ------------------------------------------------
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# --- API ---------------------------------------------------------------------
GEMINI_API_KEY=

# --- Staging CORS (comma-separated extra origins) ----------------------------
# Set this on staging servers to allow cross-origin requests from the frontend.
# Example: https://staging.databook.nyc,http://staging.databook.nyc
CORS_EXTRA_ORIGINS=
