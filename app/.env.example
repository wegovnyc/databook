# =============================================================================
# Databook Laravel .env — Copy this file to .env and fill in the values.
# =============================================================================

APP_NAME="WeGov Research"
APP_ENV=staging               # staging | production
APP_KEY=                      # Generate with: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8580

LOG_CHANNEL=stack

# --- MySQL (Laravel metadata) ------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql                 # Docker service name
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis              # Docker service name
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Session & Cache ---------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Databook API (FastAPI) --------------------------------------------------
# Internal Docker URL for server-side PHP calls (DatabookAPI::req)
FAPI_ENTRY=http://api:8000

# ⚠️ Browser-facing URL for client-side JS calls (DatabookAPI::url / fapireq)
# Must match the public domain where the API is accessible via HTTPS.
FAPI_PUBLIC_ENTRY=http://localhost:8581

# ⚠️ Must be a valid JWT with read+write scopes, NOT the JWT signing key.
# Generate via: POST /login with valid user credentials, or copy from production.
FAPI_KEY=

# --- External APIs -----------------------------------------------------------
CARTO_KEY=
GEOCLIENT_KEY=
AIRTABLE_KEY=
NEWSLETTER_DOC_ID=
ORGS_DOC_ID=
APP_API_KEY=

# --- Mail (optional) ---------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
